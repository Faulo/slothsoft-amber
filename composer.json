{
    "name": "slothsoft/amber",
    "description": "A Farah module for processing game files from the amber engine (i.e., Ambermoon and Amberstar).",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "slothsoft/core": "^1.14.28",
        "slothsoft/farah": "^1.29.5",
        "slothsoft/savegame": "^1.3.12",
        "ext-imagick": "*",
        "ext-gd": "*",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.13"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\Amber\\": "src"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "keywords": [
        "slothsoft",
        "farah-module",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Amber\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-amber/",
    "config": {
        "process-timeout": 3600,
        "platform": {
            "php": "8.2"
        }
    }
}
